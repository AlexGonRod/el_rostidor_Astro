{
  "name": "elrostidor",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:release": "node scripts/check-placeholders.mjs --strict",
    "test:unit": "vitest run",
    "test:contract": "vitest run tests/unit/contract && playwright test tests/e2e/contract",
    "test:e2e": "playwright test",
    "contract:fix": "node scripts/contract-lock.mjs --write",
    "contract:verify": "node scripts/contract-lock.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}

---
import { business, whatsappUrl } from '../../data/business';
import { dictionaries, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];
const wa = whatsappUrl(t.cta.whatsappMessage);
---

<nav
  aria-label={t.a11y.quickActions}
  class="fixed inset-x-0 bottom-0 z-40 flex border-t border-line bg-white px-2 pt-1.5 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-[0_-4px_12px_rgb(30_26_23/0.08)] lg:hidden"
>
  <a href={`tel:${business.phone}`} class="flex min-h-14 flex-1 flex-col items-center justify-center gap-1 text-[0.8125rem] font-bold">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path>
    </svg>
    {t.cta.call}
  </a>
  {
    wa && (
      <a href={wa} class="flex min-h-14 flex-1 flex-col items-center justify-center gap-1 text-[0.8125rem] font-bold">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path>
        </svg>
        {t.cta.whatsapp}
      </a>
    )
  }
  <a href={business.directionsUrl} class="flex min-h-14 flex-1 flex-col items-center justify-center gap-1 text-[0.8125rem] font-bold">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </svg>
    {t.cta.directions}
  </a>
</nav>

---
import { Image } from 'astro:assets';
import { dictionaries, type Lang } from '../../i18n/utils';
import type { AllergenKey } from '../../lib/allergens';
import AllergenIcons from './AllergenIcons.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  lang: Lang;
  name: string;
  tag?: 'popular' | 'specialty' | 'seasonal';
  photo?: string;
  allergens?: AllergenKey[];
}
const { lang, name, tag, photo, allergens = [] } = Astro.props;
const texts = dictionaries[lang];

// Las fotos reales van en src/assets/dishes/ y se enlazan con el campo `photo` del plato.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/dishes/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const image = photo ? photos[`/src/assets/dishes/${photo}`]?.default : undefined;
---

<div class="min-w-0 overflow-hidden rounded-[0.625rem] border border-line bg-white">
  {
    image ? (
      <Image src={image} alt={name} widths={[320, 480, 640]} sizes="(min-width: 1024px) 18rem, 90vw" class="h-40 w-full object-cover" />
    ) : (
      <Placeholder label={texts.carta.photo} class="h-40" />
    )
  }
  <div class="px-5 py-4">
    <p class="mb-1.5 min-h-[1.125rem] text-xs font-bold tracking-[0.08em] text-accent uppercase">
      {tag ? texts.carta.tags[tag] : ''}
    </p>
    {/* El tamaño del nombre (text-xl) fija también el em de los iconos: 1.25em respecto al nombre. */}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xl">
    <h4 class="min-w-0 font-display font-bold">{name}</h4>
    {/* Los iconos de alérgenos solo en tarjetas sin foto; las que ya tienen imagen no cambian. */}
    {!image && <AllergenIcons lang={lang} allergens={allergens} class="ml-auto" />}
  </div>
  </div>
</div>

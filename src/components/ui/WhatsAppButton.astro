---
/**
 * Botón «WhatsApp» (AGENTS.md 7.3): mismo enlace y mensaje del idioma en todos los sitios.
 * Si `business.whatsapp` es null no pinta nada (el elemento se oculta en vez de mostrarse roto).
 */
import { whatsappUrl } from '../../data/business';
import { dictionaries, type Lang } from '../../i18n/utils';
import Button from './Button.astro';

interface Props {
  lang: Lang;
  variant?: 'primary' | 'secondary' | 'light' | 'outline-light';
  size?: 'md' | 'sm';
}
const { lang, variant = 'secondary', size = 'md' } = Astro.props;
const t = dictionaries[lang];
const href = whatsappUrl(t.cta.whatsappMessage);
---

{
  href && (
    <Button href={href} variant={variant} size={size} class="gap-2" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
        <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path>
      </svg>
      {t.cta.whatsapp}
    </Button>
  )
}

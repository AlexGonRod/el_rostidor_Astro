---
import { getEntry } from 'astro:content';
import { dictionaries, withPlaceholders, type Lang } from '../../i18n/utils';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];

const [week, weekend] = await Promise.all([
  getEntry('menus', 'week'),
  getEntry('menus', 'weekend'),
]);

/** Si el cliente aún no ha cargado los platos, se muestran como [Primer plat] etc. */
const lines = (items: { ca: string; es: string }[]) =>
  items.length ? items.map((item) => item[lang]) : t.menus.pendingItems.map((item) => `[${item}]`);

const cards = [
  { key: 'week', copy: t.menus.week, data: week!.data },
  { key: 'weekend', copy: t.menus.weekend, data: weekend!.data },
];
---

<section id="menus" class="bg-soft" aria-labelledby="menus-title">
  <div class="wrap py-12 lg:py-18">
    <SectionHeading id="menus-title" eyebrow={t.menus.eyebrow} title={t.menus.title} lead={t.menus.lead} />
    <div class="flex flex-wrap gap-6">
      {
        cards.map(({ key, copy, data }) => (
          <article class="min-w-0 flex-[1_1_22rem] rounded-[0.625rem] border border-line bg-white p-6 lg:p-8" data-menu={key}>
            <h3 class="mb-1 font-display text-2xl font-bold">{copy.title}</h3>
            <p class="mb-5 text-muted">{copy.subtitle}</p>
            <ul class="mb-6 grid gap-2.5">
              {lines(data.items).map((line) => (
                <li class="border-b border-line pb-2.5" set:html={withPlaceholders(line)} />
              ))}
            </ul>
            <Button href="#encarrega" variant="secondary" size="sm">{t.cta.order}</Button>
          </article>
        ))
      }

      <article
        class="on-dark on-accent flex min-w-0 flex-[1_1_22rem] flex-col justify-between gap-6 rounded-[0.625rem] bg-accent p-6 text-white lg:p-8"
        data-menu="thursday"
      >
        <div>
          <h3 class="mb-3 font-display text-4xl leading-[1.1] font-bold">{t.menus.thursday.title}</h3>
          <p class="mb-4 text-[1.0625rem]">{t.menus.thursday.text}</p>
          <p class="rounded-md bg-black/22 px-4 py-3 text-[1.0625rem] font-bold" set:html={withPlaceholders(t.menus.thursday.notice)} />
        </div>
        <Button href="#encarrega" variant="light" class="self-start">{t.cta.order}</Button>
      </article>
    </div>
  </div>
</section>

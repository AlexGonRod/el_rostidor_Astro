---
import { getCollection } from 'astro:content';
import { business } from '../../data/business';
import { dictionaries, withPlaceholders, type Lang } from '../../i18n/utils';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];
const reviews = await getCollection('reviews');
---

<section id="opinions" aria-labelledby="reviews-title">
  <div class="wrap py-12 lg:py-18">
    <SectionHeading id="reviews-title" eyebrow={t.reviews.eyebrow} title={t.reviews.title} class="!mb-4" />
    <p class="mb-8 text-lg text-muted">
      <strong class="text-ink" set:html={withPlaceholders(t.reviews.rating)} />
    </p>
    <ul class="flex flex-wrap gap-6">
      {
        reviews.map(({ data }) => (
          <li class="min-w-0 flex-[1_1_18rem]">
            <figure class="h-full rounded-[0.625rem] border border-line p-7">
              <blockquote class="mb-5 text-lg leading-normal">{data.text}</blockquote>
              <figcaption class="text-sm text-muted">
                <strong class="text-ink">{data.author}</strong> · {t.reviews.source}
                {data.lang !== lang && ` (${t.reviews.originalEs})`}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    <p class="mt-6"><a href={business.googleListingUrl} rel="noopener" class="inline-flex min-h-11 items-center font-bold text-accent hover:underline">{t.reviews.all}</a></p>
  </div>
</section>
